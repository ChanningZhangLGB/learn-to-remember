# Copy this file to `config.env` and fill in your API keys.
#
# OpenAI keys are used for:
#   - LLM calls when running OpenAI models (gpt-4o-mini, etc.)
#   - Text embeddings (text-embedding-3-small) — `OPENAI_API_KEY_EMBED`
#
# You only need keys for the providers you intend to use.

# OpenAI keys (LLM + embeddings). Multiple keys allow parallel runs.
OPENAI_API_KEY_0="<your-openai-key-0>"
OPENAI_API_KEY_1="<your-openai-key-1>"
OPENAI_API_KEY_2="<your-openai-key-2>"

# Dedicated key reserved for embedding calls when running non-OpenAI LLMs
OPENAI_API_KEY_EMBED="<your-openai-key-for-embeddings>"

# Google Gemini (gemini-2.5-flash-lite, etc.)
GEMINI_API_KEY="<your-gemini-key>"

# Anthropic Claude
ANTHROPIC_API_KEY="<your-anthropic-key>"

# DeepSeek
DEEPSEEK_API_KEY="<your-deepseek-key>"

# NVIDIA NIM (open-source models — Llama, Qwen, OSS, etc.)
NVIDIA_API_KEY_LLAMA="<your-nvidia-key-llama>"
NVIDIA_API_KEY_QWEN="<your-nvidia-key-qwen>"
NVIDIA_API_KEY_NEMOTRON="<your-nvidia-key-nemotron>"
NVIDIA_API_KEY_DEEPSEEK="<your-nvidia-key-deepseek>"
NVIDIA_API_KEY_OSS_20B="<your-nvidia-key-oss-20b>"
NVIDIA_API_KEY_OSS_120B="<your-nvidia-key-oss-120b>"
