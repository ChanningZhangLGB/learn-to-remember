{
  "experiment": {
    "name": "past_sol_plus_ccme_run1",
    "task": "MathVista_testmini_250",
    "approach_name": "LeRe",
    "run_id": 1,
    "description": "Template config. Switch retrieval mode by editing the 'retrieval' block.",
    "retrieval_mode_guide": {
      "ccme_topk": "use_full_bank=false, retrieve_top_k=3,  inject_past_solutions=false",
      "ccme_k0": "use_full_bank=false, retrieve_top_k=0,  inject_past_solutions=false",
      "full_bank": "use_full_bank=true,  retrieve_top_k=any, inject_past_solutions=false",
      "past_sol_only": "use_full_bank=false, retrieve_top_k=0,  inject_past_solutions=true, past_solutions_top_k=3",
      "past_sol_plus_ccme": "use_full_bank=false, retrieve_top_k=3,  inject_past_solutions=true, past_solutions_top_k=3"
    }
  },
  "llm": {
    "model_name": "gemini/gemini-2.5-flash-lite",
    "temperature": 0.0,
    "max_tokens": 16384,
    "execute_python_code": true
  },
  "adapters": {
    "embedding_model": "clip",
    "base_dim": 768,
    "projection_dim": 512,
    "hidden_dim": 384,
    "enabled": true
  },
  "ccme": {
    "temperature": 0.07,
    "adaptive_temperature": true,
    "use_exposure_annealing": true
  },
  "crte": {
    "d_temporal": 64,
    "lambda_cluster": 0.1,
    "lambda_margin": 0.1,
    "margin_eta": 0.2
  },
  "online_training": {
    "enable_training": true,
    "k_upd": 8,
    "num_train_steps": 4,
    "batch_size": 8,
    "temporal_decay": 0.9,
    "device": "cuda"
  },
  "ccme_training": {
    "buffer_size": 512,
    "learning_rate": 2e-05,
    "min_positive": 1,
    "stability_window": 20,
    "stability_threshold": 0.1,
    "prune_on_instability": true,
    "false_negative_threshold": 0.75,
    "reliability_prune_threshold": 0.35
  },
  "crte_training": {
    "buffer_size": 256,
    "learning_rate": 2e-05,
    "lambda_crte": 1.0,
    "min_positive": 1,
    "stability_window": 20,
    "stability_threshold": 0.1,
    "prune_on_instability": true,
    "stale_positive_threshold": 0.15,
    "trivial_negative_threshold": 0.05
  },
  "per_query_memory_operations": {
    "dedup_threshold": 0.75,
    "prune_reliability_threshold": 0.35,
    "pruning_mode": "OR",
    "staleness_decay_lambda": 0.01,
    "min_queries_before_operations": 10
  },
  "periodic_memory_refinement": {
    "shard_capacity": 10,
    "n_clusters_mode": "fixed",
    "n_clusters_fixed": 16,
    "redundancy_threshold": 0.75,
    "min_items_for_refinement": 5,
    "refinement_mode": "fixed",
    "refine_every_updates": 4,
    "post_refinement_grace": 2
  },
  "retrieval": {
    "use_full_bank": false,
    "retrieve_top_k": 3,
    "ccme_alpha": 0.9,
    "inject_past_solutions": true,
    "past_solutions_top_k": 3,
    "synthesizer": false
  },
  "experiment_control": {
    "max_n_samples": 250,
    "verbose": true,
    "save_interval": 10,
    "shuffle_seed": null,
    "save_detailed_outputs": true,
    "dataset_description": "MathVista testmini: 250 multimodal math problems combining visual content (figures, charts, geometry diagrams, tables) with mathematical reasoning. Tasks include arithmetic, algebra, geometry, statistics, and scientific reasoning. Questions are either free-form or multiple-choice. Each sample contains an image essential to solving the problem \u2014 the visual content is not decorative but carries key quantitative or structural information required for the answer."
  },
  "paths": {
    "data_dir": "./data/MathVista_testmini_250",
    "prompts_dir": "./prompts",
    "results_root": "./results",
    "precomputed_embeddings_csv": "./embeddings/MathVista_testmini_250.csv"
  }
}